{
  "name": "warung-pos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "node --env-file-if-exists=.env scripts/serve-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "user:add": "tsx --env-file-if-exists=.env scripts/add-user.ts",
    "measure:bundle": "tsx --env-file-if-exists=.env scripts/measure-bundle.ts",
    "screenshots": "tsx --env-file-if-exists=.env scripts/screenshots.ts",
    "bench:sync": "tsx --env-file-if-exists=.env scripts/bench-sync.ts"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "dexie": "4.4.6",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
